<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Push notifications, for both apps (com.ricardofrango.squadify.push). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Retries the server's feature flags when a connection comes back (presentation/ui/startup). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <service
            android:name="com.ricardofrango.squadify.push.SquadifyMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
