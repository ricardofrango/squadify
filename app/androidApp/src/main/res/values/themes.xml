<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The stock Theme.Material.Light window is what the OS paints for the very first frame of a
         cold start, before Compose has drawn anything: with no override here it's an unstyled
         white flash ahead of the dark SplashScreen. Matching the window background to the splash's
         carbon ground (see SplashScreen.kt) makes the cold start and the Compose splash read as one
         continuous dark surface. -->
    <style name="Theme.Squadify" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">@color/ic_launcher_background</item>
        <item name="android:navigationBarColor">@color/ic_launcher_background</item>
    </style>

    <!-- The launch splash (core-splashscreen, every Android version): the designer's splash mark
         (drawable-*/splash_icon, 240dp with the mark in its middle) on carbon. The
         activity keeps it on screen until the app's own splash has gone (MainActivity), then the app's
         theme follows. -->
    <style name="Theme.Squadify.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Squadify</item>
    </style>
</resources>
